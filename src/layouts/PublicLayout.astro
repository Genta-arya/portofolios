---
import '../styles/globals.css';
import FloatingNavbar from '../components/public/FloatingNavbar';
import AuroraBackground from '../components/public/AuroraBackground';
import ScrollProgress from '../components/reactbits/ScrollProgress';
import Crosshair from '../components/reactbits/Crosshair';
import DataFetchLoader from '../components/ui/DataFetchLoader';
import ModeSelectionModal from '../components/public/ModeSelectionModal';
import Footer from '../components/public/Footer';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  keywords?: string;
}

const {
  title = 'Gentha Arya Pratama — Fullstack Developer · Web & Mobile',
  description = 'Portofolio Gentha Arya Pratama, Fullstack Developer spesialis web enterprise cepat, arsitektur REST API, dan aplikasi mobile modern.',
  ogImage = '/og-image.png',
  type = 'website',
  publishedTime,
  keywords = 'Gentha Arya Pratama, Fullstack Developer, Web Developer Indonesia, React Developer, Astro Developer, React Native, Mobile App Developer, Express JS, MySQL, Frontend Engineer, Software Engineer, Portfolio Developer, Jasa Pembuatan Website, Fastwork Freelancer',
} = Astro.props;

// Helper: Truncate descriptions cleanly to satisfy strict SEO & OpenGraph length recommendations
const truncateCleanly = (text: string, maxLen: number) => {
  if (!text || text.length <= maxLen) return text || '';
  const truncated = text.slice(0, maxLen - 3);
  const lastSpace = truncated.lastIndexOf(' ');
  return (lastSpace > 0 ? truncated.slice(0, lastSpace) : truncated) + '...';
};

const rawDesc = (description || '').trim();
// 1. Google Search snippet recommendation: 140 - 155 characters (max 160)
const metaDescription = truncateCleanly(rawDesc, 155);
// 2. OpenGraph / WhatsApp / Twitter social cards preview: 110 - 125 characters (prevents truncation on mobile)
const ogDescription = truncateCleanly(rawDesc, 125);

// Optimal SEO Title Lengths:
// 1. Google title sweet spot: <= 60 characters
// 2. OpenGraph og:title sweet spot: <= 60 characters
// 3. Twitter title sweet spot: <= 70 characters
const rawTitle = (title || '').trim();

const formatTitleCleanly = (str: string, maxLen: number) => {
  if (!str || str.length <= maxLen) return str || '';
  if (str.includes(' — ')) {
    const mainTitle = str.split(' — ')[0].trim();
    if (mainTitle.length <= maxLen) return mainTitle;
    return truncateCleanly(mainTitle, maxLen);
  }
  if (str.includes(' | ')) {
    const mainTitle = str.split(' | ')[0].trim();
    if (mainTitle.length <= maxLen) return mainTitle;
    return truncateCleanly(mainTitle, maxLen);
  }
  return truncateCleanly(str, maxLen);
};

const metaTitle = formatTitleCleanly(rawTitle, 60);
const ogTitle = formatTitleCleanly(rawTitle, 60);
const twitterTitle = formatTitleCleanly(rawTitle, 70);

// Dynamic origin resolution: uses actual incoming host header so OG URLs always match current deployment domain
const forwardedProto = Astro.request.headers.get('x-forwarded-proto') || 'https';
const forwardedHost = Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host');
const originFromHeader = forwardedHost ? `${forwardedProto}://${forwardedHost}` : null;

const siteUrl = originFromHeader || (Astro.url.origin && !Astro.url.origin.includes('localhost') ? Astro.url.origin : (Astro.site?.toString().replace(/\/$/, '') || 'https://portofolio-beta-two-98.vercel.app'));
const canonicalURL = new URL(Astro.url.pathname, siteUrl);

const rawOgImage = (ogImage && ogImage.trim()) ? ogImage.trim() : '/og-image.png';
const absoluteOgImage = rawOgImage.startsWith('http')
  ? rawOgImage
  : `${siteUrl}${rawOgImage.startsWith('/') ? '' : '/'}${rawOgImage}`;

// Schema.org Structured Data Graph
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      'url': siteUrl,
      'name': 'Gentha Arya Pratama — Fullstack Developer Portfolio',
      'description': metaDescription,
      'inLanguage': 'id-ID',
      'publisher': {
        '@id': `${siteUrl}/#person`,
      },
    },
    {
      '@type': 'Person',
      '@id': `${siteUrl}/#person`,
      'name': 'Gentha Arya Pratama',
      'alternateName': 'Gentha Arya',
      'url': siteUrl,
      'jobTitle': 'Fullstack Developer',
      'description': 'Fullstack Developer spesialis web enterprise berkecepatan tinggi dan aplikasi mobile React Native & Android.',
      'image': `${siteUrl}/images/gentha-photo.jpg`,
      'sameAs': [
        'https://github.com/Genta-arya',
        'https://fastwork.id/user/babfpfzm',
        'https://linkedin.com/in/mgentaarya',
      ],
      'knowsAbout': [
        'Web Application Development',
        'Mobile Application Development',
        'React.js',
        'Astro',
        'Node.js',
        'Express.js',
        'MySQL Database Architecture',
        'React Native',
        'Tailwind CSS',
        'TypeScript',
        'RESTful APIs',
      ],
    },
    ...(type === 'article' && publishedTime
      ? [
          {
            '@type': 'BlogPosting',
            '@id': `${canonicalURL.toString()}#article`,
            'isPartOf': {
              '@id': `${siteUrl}/#website`,
            },
            'author': {
              '@id': `${siteUrl}/#person`,
            },
            'headline': title,
            'description': metaDescription,
            'image': absoluteOgImage,
            'datePublished': publishedTime,
            'mainEntityOfPage': canonicalURL.toString(),
            'publisher': {
              '@id': `${siteUrl}/#person`,
            },
            'inLanguage': 'id-ID',
          },
        ]
      : []),
  ],
};
---

<!doctype html>
<html lang="id" class="dark scroll-smooth overflow-x-hidden w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, minimum-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Meta Tags -->
    <title>{metaTitle}</title>
    <meta name="title" content={metaTitle} />
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Gentha Arya Pratama" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#05030A" />
    <meta name="color-scheme" content="dark" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Gentha Arya Pratama" />
    <meta property="og:locale" content="id_ID" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:secure_url" content={absoluteOgImage} />
    <meta property="og:image:type" content={absoluteOgImage.endsWith('.png') ? 'image/png' : 'image/jpeg'} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogTitle} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={twitterTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={absoluteOgImage} />
    <meta name="twitter:image:alt" content={twitterTitle} />
    <meta name="twitter:creator" content="@mgentaarya" />
    <meta name="twitter:site" content="@mgentaarya" />

    <!-- Structured Data (Schema.org JSON-LD) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Fonts Preconnect -->
    <!-- Initialize Display Mode early (Default Lite) -->
    <script is:inline>
      (function() {
        try {
          var mode = localStorage.getItem('gentha_display_mode') || 'lite';
          document.documentElement.setAttribute('data-display-mode', mode);
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="text-[#F8FAFC] antialiased min-h-screen selection:bg-purple-600 selection:text-white overflow-x-hidden w-full max-w-full relative">
    <ModeSelectionModal client:load />
    <ScrollProgress client:load />
    <AuroraBackground client:load />
    <Crosshair client:load color="#C084FC" thickness={1} opacity={0.65} lineStyle="dashed" />
    <DataFetchLoader client:load mode="fullscreen" globalListener={true} />
    <FloatingNavbar client:load currentPath={Astro.url.pathname} />
    
    <main class="relative w-full max-w-full overflow-x-hidden">
      <slot />
    </main>

    <Footer client:visible />
  </body>
</html>
