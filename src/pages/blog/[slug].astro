---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { db } from '../../db';
import { blogPosts, blogCategories } from '../../db/schema';
import { eq, ne, desc } from 'drizzle-orm';
import { formatDate } from '../../lib/utils';
import { Clock, Eye, Share2, Calendar, ArrowLeft, BookOpen, MessageSquare, Check, Copy } from 'lucide-react';
import { FacebookIcon, TelegramIcon, DiscordIcon, WhatsAppIcon, LinkedinIcon } from '../../components/ui/Icons';
import ArticleInteractiveBar from '../../components/public/ArticleInteractiveBar';
import MarkdownIt from 'markdown-it';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

let post: any = null;
let category: any = null;
let relatedPosts: any[] = [];

try {
  const [p] = await db
    .select()
    .from(blogPosts)
    .where(eq(blogPosts.slug, slug))
    .limit(1);

  if (!p) {
    return Astro.redirect('/blog');
  }
  post = p;

  if (p.categoryId) {
    const [cat] = await db
      .select()
      .from(blogCategories)
      .where(eq(blogCategories.id, p.categoryId))
      .limit(1);
    category = cat;
  }

  relatedPosts = await db
    .select({
      id: blogPosts.id,
      title: blogPosts.title,
      slug: blogPosts.slug,
      coverImageUrl: blogPosts.coverImageUrl,
      readingTimeMinutes: blogPosts.readingTimeMinutes,
      createdAt: blogPosts.createdAt,
    })
    .from(blogPosts)
    .where(ne(blogPosts.slug, slug))
    .orderBy(desc(blogPosts.createdAt))
    .limit(2);
} catch (err) {
  console.error('Error fetching blog post:', err);
  return Astro.redirect('/blog');
}

// Markdown-to-HTML parser setup
const md = new MarkdownIt({
  html: true,
  linkify: true,
  typographer: true,
  breaks: false
});

let renderedContent = post.content || '';

// Detect if post.content is Markdown
const isMarkdown = post.content && (
  post.content.trim().startsWith('#') ||
  post.content.includes('\n## ') ||
  post.content.includes('```') ||
  !/<(p|h2|h3|div|ul|ol|pre)[^>]*>/i.test(post.content)
);

if (isMarkdown) {
  // Strip duplicate top-level # H1 if present
  let cleanMd = post.content.replace(/^#\s+[^\n]+\n+/, '');
  renderedContent = md.render(cleanMd);
}

// Ensure all <h2> tags have an id for TOC jumping
renderedContent = renderedContent.replace(/<h2([^>]*)>(.*?)<\/h2>/gi, (match: string, attrs: string, titleText: string) => {
  if (attrs.includes('id=')) return match;
  const cleanTitle = titleText.replace(/<[^>]+>/g, '').trim();
  const id = cleanTitle.toLowerCase().replace(/[^\w]+/g, '-');
  return `<h2 id="${id}"${attrs}>${titleText}</h2>`;
});

// Generate simple Table of Contents from h2 headers in HTML
const headingRegex = /<h2[^>]*id=["']([^"']+)["'][^>]*>(.*?)<\/h2>/gi;
const headings: { title: string; id: string }[] = [];
let match;
while ((match = headingRegex.exec(renderedContent)) !== null) {
  const id = match[1];
  const title = match[2].replace(/<[^>]+>/g, '').trim();
  headings.push({ title, id });
}

// Dynamic origin resolution from incoming request headers
const forwardedProto = Astro.request.headers.get('x-forwarded-proto') || 'https';
const forwardedHost = Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host');
const originFromHeader = forwardedHost ? `${forwardedProto}://${forwardedHost}` : null;
const resolvedSiteUrl = originFromHeader || (Astro.url.origin && !Astro.url.origin.includes('localhost') ? Astro.url.origin : 'https://mgentaarya.my.id');
const shareUrl = `${resolvedSiteUrl}/blog/${post.slug}`;
---

<PublicLayout
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt}
  ogImage={post.coverImageUrl || '/og-image.png'}
  type="article"
  publishedTime={post.createdAt ? new Date(post.createdAt).toISOString() : undefined}
>
  <article class="pt-32 pb-24 max-w-5xl mx-auto px-4 sm:px-6">
    
    {/* Back to Blog */}
    <a
      href="/blog"
      class="inline-flex items-center gap-2 text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors mb-8"
    >
      <ArrowLeft className="w-4 h-4" />
      <span>Kembali ke Semua Artikel</span>
    </a>

    {/* Header Info */}
    <div class="mb-10">
      {category && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-600/20 text-purple-300 border border-purple-500/30 uppercase tracking-wider mb-4">
          {category.name}
        </span>
      )}
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
        {post.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-zinc-400 py-4 border-y border-purple-500/15">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-purple-600 to-fuchsia-500 flex items-center justify-center text-[10px] text-white font-bold">
            G
          </div>
          <span class="text-white font-medium">Gentha Arya Pratama</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <Calendar className="w-3.5 h-3.5 text-purple-400" />
          <span>{formatDate(post.publishedAt || post.createdAt)}</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <Clock className="w-3.5 h-3.5 text-purple-400" />
          <span>{post.readingTimeMinutes || 3} menit baca</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <Eye className="w-3.5 h-3.5 text-purple-400" />
          <span id="view-count-display">{post.viewsCount || 0} views</span>
        </div>
      </div>
    </div>

    {/* Hero Cover Image */}
    <div class="rounded-3xl overflow-hidden aspect-[16/9] mb-12 bg-[#0a0515] border border-purple-500/25 shadow-2xl flex items-center justify-center">
      <img
        src={post.coverImageUrl}
        alt={post.title}
        class="w-full h-full object-contain"
      />
    </div>

    {/* Content Layout (Article Body + Sidebar TOC) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      {/* Article Body */}
      <div class="lg:col-span-8">
        {/* Interactive Reading Utility Bar (TTS audio, font scaling, bookmarking, and reactions) */}
        <ArticleInteractiveBar client:load slug={post.slug} title={post.title} articleSelector=".article-prose" />

        <div
          class="article-prose prose prose-invert prose-purple max-w-none text-zinc-300 leading-relaxed text-base space-y-4 prose-headings:text-white prose-headings:font-bold prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-xl prose-code:text-purple-300 prose-code:bg-[#120B24] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:border prose-code:border-purple-500/20 prose-pre:bg-[#0D0818] prose-pre:border prose-pre:border-purple-500/25 prose-img:rounded-2xl"
          set:html={renderedContent}
        />

        {/* Share & Feedback Action Bar */}
        <div class="mt-14 pt-8 border-t border-purple-500/20 flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="text-xs font-semibold text-zinc-300 flex items-center gap-2">
            <Share2 className="w-4 h-4 text-purple-400" />
            <span>Bagikan artikel ini:</span>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2">
            {/* Copy Link */}
            <button
              id="copy-link-btn"
              type="button"
              class="px-3 py-1.5 rounded-xl bg-[#120B24] border border-purple-500/30 text-xs font-medium text-zinc-300 hover:text-white hover:bg-purple-900/40 hover:border-purple-400 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
              title="Salin tautan artikel"
            >
              <Copy className="w-3.5 h-3.5 text-purple-400" />
              <span id="copy-text">Salin Link</span>
            </button>

            {/* WhatsApp */}
            <a
              href={`https://wa.me/?text=${encodeURIComponent(post.title + ' — ' + shareUrl)}`}
              data-share="whatsapp"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#0b2416]/70 border border-emerald-500/30 text-xs font-medium text-emerald-300 hover:text-white hover:bg-emerald-900/60 hover:border-emerald-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke WhatsApp"
            >
              <WhatsAppIcon className="w-3.5 h-3.5 text-emerald-400 fill-emerald-400" />
              <span>WhatsApp</span>
            </a>

            {/* Facebook */}
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
              data-share="facebook"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#0d1c3a]/70 border border-blue-500/30 text-xs font-medium text-blue-300 hover:text-white hover:bg-blue-900/60 hover:border-blue-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke Facebook"
            >
              <FacebookIcon className="w-3.5 h-3.5 text-blue-400 fill-blue-400" />
              <span>Facebook</span>
            </a>

            {/* Telegram */}
            <a
              href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.title)}`}
              data-share="telegram"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#092232]/70 border border-sky-500/30 text-xs font-medium text-sky-300 hover:text-white hover:bg-sky-900/60 hover:border-sky-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke Telegram"
            >
              <TelegramIcon className="w-3.5 h-3.5 text-sky-400 fill-sky-400" />
              <span>Telegram</span>
            </a>

            {/* Discord (Copies link with helpful feedback) */}
            <button
              type="button"
              id="discord-share-btn"
              class="px-3 py-1.5 rounded-xl bg-[#171334]/70 border border-indigo-500/30 text-xs font-medium text-indigo-300 hover:text-white hover:bg-indigo-900/60 hover:border-indigo-400 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
              title="Salin untuk dibagikan di Discord"
            >
              <DiscordIcon className="w-3.5 h-3.5 text-indigo-400 fill-indigo-400" />
              <span id="discord-share-text">Discord</span>
            </button>

            {/* LinkedIn */}
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
              data-share="linkedin"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#0a1f33]/70 border border-cyan-500/30 text-xs font-medium text-cyan-300 hover:text-white hover:bg-cyan-900/60 hover:border-cyan-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke LinkedIn"
            >
              <LinkedinIcon className="w-3.5 h-3.5 text-cyan-400 fill-cyan-400" />
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        {/* Author Bio Box */}
        <div class="mt-10 p-6 rounded-3xl bg-[#0D0818]/90 border border-purple-500/25 flex items-center gap-5">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-600 to-fuchsia-600 flex items-center justify-center text-white font-extrabold text-xl shrink-0 shadow-lg">
            G
          </div>
          <div>
            <h4 class="text-sm font-bold text-white">Ditulis oleh Gentha Arya Pratama</h4>
            <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
              Fullstack Developer berdedikasi membangun aplikasi web &amp; mobile modern dengan fokus pada performa, arsitektur bersih, dan user experience.
            </p>
          </div>
        </div>
      </div>

      {/* Sidebar: Table of Contents & Related */}
      <div class="lg:col-span-4 sticky top-28 space-y-6">
        {headings.length > 0 && (
          <div class="p-6 rounded-3xl bg-[#0D0818]/90 border border-purple-500/20 shadow-xl">
            <h3 class="text-xs font-bold text-zinc-300 uppercase tracking-wider mb-4 flex items-center gap-2">
              <BookOpen className="w-4 h-4 text-purple-400" />
              <span>Daftar Isi</span>
            </h3>
            <ul class="space-y-2.5 text-xs">
              {headings.map((h) => (
                <li>
                  <a
                    href={`#${h.id}`}
                    class="text-zinc-400 hover:text-purple-300 transition-colors line-clamp-1 block py-0.5"
                  >
                    • {h.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Related Posts */}
        {relatedPosts.length > 0 && (
          <div class="p-6 rounded-3xl bg-[#0D0818]/90 border border-purple-500/20 shadow-xl">
            <h3 class="text-xs font-bold text-zinc-300 uppercase tracking-wider mb-4">
              Artikel Terkait
            </h3>
            <div class="space-y-4">
              {relatedPosts.map((r) => (
                <a
                  key={r.id}
                  href={`/blog/${r.slug}`}
                  class="group block p-3 rounded-2xl bg-[#120B24]/60 border border-purple-500/15 hover:border-purple-400/40 transition-all"
                >
                  <h4 class="text-xs font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2 mb-1">
                    {r.title}
                  </h4>
                  <span class="text-[10px] text-zinc-500">
                    {r.readingTimeMinutes || 3} min baca
                  </span>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

    </div>

  </article>

  {/* Client script for auto-incrementing view count, copy button, and code block copy buttons */}
  <script define:vars={{ slug }}>
    // Increment view count in background
    // Automatically update share URLs to active browser URL (avoiding localhost or stale host)
    const currentUrl = window.location.href;
    const postTitle = document.title || 'Artikel';

    const waLink = document.querySelector('a[data-share="whatsapp"]');
    if (waLink) waLink.href = `https://wa.me/?text=${encodeURIComponent(postTitle + ' — ' + currentUrl)}`;

    const fbLink = document.querySelector('a[data-share="facebook"]');
    if (fbLink) fbLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;

    const tgLink = document.querySelector('a[data-share="telegram"]');
    if (tgLink) tgLink.href = `https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(postTitle)}`;

    const inLink = document.querySelector('a[data-share="linkedin"]');
    if (inLink) inLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;

    // Copy link helper
    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        copyText.textContent = 'Tersalin!';
        setTimeout(() => {
          copyText.textContent = 'Salin Link';
        }, 2000);
      });
    }

    // Discord share helper (copies link and informs user to paste into Discord)
    const discordBtn = document.getElementById('discord-share-btn');
    const discordText = document.getElementById('discord-share-text');
    if (discordBtn && discordText) {
      discordBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        discordText.textContent = 'Link Tersalin!';
        setTimeout(() => {
          discordText.textContent = 'Discord';
        }, 2000);
      });
    }

    // Auto-inject copy buttons to all <pre> code blocks inside article
    document.querySelectorAll('.article-prose pre').forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;
      pre.style.position = 'relative';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn absolute top-2.5 right-2.5 px-2.5 py-1 rounded-lg text-[10px] font-semibold bg-[#1a0f30]/90 text-purple-300 border border-purple-500/30 hover:bg-purple-900/60 hover:text-white transition-all cursor-pointer backdrop-blur-sm shadow';
      btn.textContent = 'Salin Kode';

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const codeText = pre.querySelector('code')?.innerText || pre.innerText || '';
        navigator.clipboard.writeText(codeText);
        btn.textContent = '✓ Tersalin!';
        btn.classList.add('text-emerald-400', 'border-emerald-500/50');
        setTimeout(() => {
          btn.textContent = 'Salin Kode';
          btn.classList.remove('text-emerald-400', 'border-emerald-500/50');
        }, 2000);
      });

      pre.appendChild(btn);
    });
  </script>
</PublicLayout>

