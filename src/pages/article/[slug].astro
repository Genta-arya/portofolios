---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { db } from '../../db';
import { blogPosts, blogCategories } from '../../db/schema';
import { eq, ne, desc } from 'drizzle-orm';
import { formatDate } from '../../lib/utils';
import { Clock, Eye, Share2, Calendar, ArrowLeft, ArrowRight, ArrowUpRight, BookOpen, MessageSquare, Check, Copy, Smartphone, Laptop, Briefcase } from 'lucide-react';
import { FacebookIcon, TelegramIcon, DiscordIcon, WhatsAppIcon, LinkedinIcon, FastworkIcon } from '../../components/ui/Icons';
import ArticleInteractiveBar from '../../components/public/ArticleInteractiveBar';
import MarkdownIt from 'markdown-it';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/article');
}

let post: any = null;
let category: any = null;
let relatedPosts: any[] = [];
let moreArticles: any[] = [];

try {
  const [p] = await db
    .select()
    .from(blogPosts)
    .where(eq(blogPosts.slug, slug))
    .limit(1);

  if (!p) {
    return Astro.redirect('/article');
  }
  post = p;

  if (p.categoryId) {
    const [cat] = await db
      .select()
      .from(blogCategories)
      .where(eq(blogCategories.id, p.categoryId))
      .limit(1);
    category = cat;
  }

  // Artikel Terkait (dalam topik/kategori yang sama jika ada, atau fallback postingan terbaru lainnya)
  relatedPosts = await db
    .select({
      id: blogPosts.id,
      title: blogPosts.title,
      slug: blogPosts.slug,
      coverImageUrl: blogPosts.coverImageUrl,
      readingTimeMinutes: blogPosts.readingTimeMinutes,
      createdAt: blogPosts.createdAt,
      publishedAt: blogPosts.publishedAt,
    })
    .from(blogPosts)
    .where(ne(blogPosts.slug, slug))
    .orderBy(desc(blogPosts.createdAt))
    .limit(3);

  // Artikel Lainnya (Rekomendasi 5 artikel untuk section bawah berbentuk memanjang flex-col)
  moreArticles = await db
    .select({
      id: blogPosts.id,
      title: blogPosts.title,
      slug: blogPosts.slug,
      excerpt: blogPosts.excerpt,
      coverImageUrl: blogPosts.coverImageUrl,
      readingTimeMinutes: blogPosts.readingTimeMinutes,
      createdAt: blogPosts.createdAt,
      publishedAt: blogPosts.publishedAt,
    })
    .from(blogPosts)
    .where(ne(blogPosts.slug, slug))
    .orderBy(desc(blogPosts.createdAt))
    .offset(1)
    .limit(5);
} catch (err) {
  console.error('Error fetching blog post:', err);
  return Astro.redirect('/article');
}

// Markdown-to-HTML parser setup
const md = new MarkdownIt({
  html: true,
  linkify: true,
  typographer: true,
  breaks: false
});

let renderedContent = post.content || '';

// Detect if post.content is Markdown
const isMarkdown = post.content && (
  post.content.trim().startsWith('#') ||
  post.content.includes('\n## ') ||
  post.content.includes('```') ||
  !/<(p|h2|h3|div|ul|ol|pre)[^>]*>/i.test(post.content)
);

if (isMarkdown) {
  // Strip duplicate top-level # H1 if present
  let cleanMd = post.content.replace(/^#\s+[^\n]+\n+/, '');
  renderedContent = md.render(cleanMd);
}

// Ensure all <h2> tags have an id for TOC jumping
renderedContent = renderedContent.replace(/<h2([^>]*)>(.*?)<\/h2>/gi, (match: string, attrs: string, titleText: string) => {
  if (attrs.includes('id=')) return match;
  const cleanTitle = titleText.replace(/<[^>]+>/g, '').trim();
  const id = cleanTitle.toLowerCase().replace(/[^\w]+/g, '-');
  return `<h2 id="${id}"${attrs}>${titleText}</h2>`;
});

// Generate simple Table of Contents from h2 headers in HTML
const headingRegex = /<h2[^>]*id=["']([^"']+)["'][^>]*>(.*?)<\/h2>/gi;
const headings: { title: string; id: string }[] = [];
let match;
while ((match = headingRegex.exec(renderedContent)) !== null) {
  const id = match[1];
  const title = match[2].replace(/<[^>]+>/g, '').trim();
  headings.push({ title, id });
}

// Dynamic origin resolution from incoming request headers
const forwardedProto = Astro.request.headers.get('x-forwarded-proto') || 'https';
const forwardedHost = Astro.request.headers.get('x-forwarded-host') || Astro.request.headers.get('host');
const originFromHeader = forwardedHost ? `${forwardedProto}://${forwardedHost}` : null;
const resolvedSiteUrl = originFromHeader || (Astro.url.origin && !Astro.url.origin.includes('localhost') ? Astro.url.origin : 'https://mgentaarya.my.id');
const shareUrl = `${resolvedSiteUrl}/article/${post.slug}`;
---

<PublicLayout
  title={post.seoTitle || post.title}
  description={post.seoDescription || post.excerpt}
  ogImage={post.coverImageUrl || '/og-image.png'}
  type="article"
  publishedTime={post.createdAt ? new Date(post.createdAt).toISOString() : undefined}
>
  <article class="pt-32 pb-24 max-w-5xl mx-auto px-4 sm:px-6">
    
    {/* Back to Articles */}
    <a
      href="/article"
      class="inline-flex items-center gap-2 text-xs font-semibold text-purple-400 hover:text-purple-300 transition-colors mb-8"
    >
      <ArrowLeft className="w-4 h-4" />
      <span>Kembali ke Semua Artikel</span>
    </a>

    {/* Header Info */}
    <div class="mb-10">
      {category && (
        <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-600/20 text-purple-300 border border-purple-500/30 uppercase tracking-wider mb-4">
          {category.name}
        </span>
      )}
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight mb-6">
        {post.title}
      </h1>

      <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs text-zinc-400 py-4 border-y border-purple-500/15">
        <div class="flex items-center gap-2">
          <div class="w-6 h-6 rounded-full bg-gradient-to-tr from-purple-600 to-fuchsia-500 flex items-center justify-center text-[10px] text-white font-bold">
            G
          </div>
          <span class="text-white font-medium">Gentha Arya Pratama</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <Calendar className="w-3.5 h-3.5 text-purple-400" />
          <span>{formatDate(post.publishedAt || post.createdAt)}</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <Clock className="w-3.5 h-3.5 text-purple-400" />
          <span>{post.readingTimeMinutes || 3} menit baca</span>
        </div>
        <span>•</span>
        <div class="flex items-center gap-1.5">
          <Eye className="w-3.5 h-3.5 text-purple-400" />
          <span id="view-count-display">{post.viewsCount || 0} views</span>
        </div>
      </div>
    </div>

    {/* Hero Cover Image (Interactive Click-to-Zoom Modal) */}
    <div
      id="hero-cover-container"
      role="button"
      tabindex="0"
      class="group relative rounded-3xl overflow-hidden aspect-[16/9] mb-12 bg-[#0a0515] border border-purple-500/25 shadow-2xl flex items-center justify-center cursor-pointer select-none"
      title="Klik untuk melihat gambar penuh"
    >
      <img
        id="hero-cover-img"
        src={post.coverImageUrl}
        alt={post.title}
        class="w-full h-full object-contain group-hover:scale-[1.02] transition-transform duration-500 pointer-events-none"
      />
      {/* Zoom Badge Indicator */}
      <div class="absolute bottom-4 right-4 px-3 py-1.5 rounded-full bg-[#0D0818]/85 backdrop-blur-md border border-purple-500/40 text-purple-200 text-xs font-semibold flex items-center gap-1.5 shadow-lg group-hover:scale-105 transition-transform duration-300 pointer-events-none">
        <svg class="w-3.5 h-3.5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          <line x1="11" y1="8" x2="11" y2="14"></line>
          <line x1="8" y1="11" x2="14" y2="11"></line>
        </svg>
        <span>Lihat Gambar Penuh</span>
      </div>
    </div>

    {/* Content Layout (Article Body + Sidebar TOC) */}
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      {/* Article Body */}
      <div class="lg:col-span-8">
        {/* Interactive Reading Utility Bar (TTS audio, font scaling, bookmarking) */}
        <ArticleInteractiveBar client:load slug={post.slug} title={post.title} articleSelector=".article-prose" mode="top" />

        <div
          class="article-prose prose prose-invert prose-purple max-w-none text-zinc-300 leading-relaxed text-base space-y-4 prose-headings:text-white prose-headings:font-bold prose-h2:text-2xl prose-h2:mt-8 prose-h2:mb-4 prose-h3:text-xl prose-code:text-purple-300 prose-code:bg-[#120B24] prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:border prose-code:border-purple-500/20 prose-pre:bg-[#0D0818] prose-pre:border prose-pre:border-purple-500/25 prose-img:rounded-2xl"
          set:html={renderedContent}
        />

        {/* Share & Feedback Action Bar */}
        <div class="mt-14 pt-8 border-t border-purple-500/20 flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="text-xs font-semibold text-zinc-300 flex items-center gap-2">
            <Share2 className="w-4 h-4 text-purple-400" />
            <span>Bagikan:</span>
          </div>
          <div class="flex flex-wrap items-center justify-center gap-2">
            {/* Copy Link */}
            <button
              id="copy-link-btn"
              type="button"
              class="px-3 py-1.5 rounded-xl bg-[#120B24] border border-purple-500/30 text-xs font-medium text-zinc-300 hover:text-white hover:bg-purple-900/40 hover:border-purple-400 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
              title="Salin tautan artikel"
            >
              <Copy className="w-3.5 h-3.5 text-purple-400" />
              <span id="copy-text">Salin Link</span>
            </button>

            {/* WhatsApp */}
            <a
              href={`https://wa.me/?text=${encodeURIComponent(post.title + ' — ' + shareUrl)}`}
              data-share="whatsapp"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#0b2416]/70 border border-emerald-500/30 text-xs font-medium text-emerald-300 hover:text-white hover:bg-emerald-900/60 hover:border-emerald-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke WhatsApp"
            >
              <WhatsAppIcon className="w-3.5 h-3.5 text-emerald-400 fill-emerald-400" />
              <span>WhatsApp</span>
            </a>

            {/* Facebook */}
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`}
              data-share="facebook"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#0d1c3a]/70 border border-blue-500/30 text-xs font-medium text-blue-300 hover:text-white hover:bg-blue-900/60 hover:border-blue-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke Facebook"
            >
              <FacebookIcon className="w-3.5 h-3.5 text-blue-400 fill-blue-400" />
              <span>Facebook</span>
            </a>

            {/* Telegram */}
            <a
              href={`https://t.me/share/url?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.title)}`}
              data-share="telegram"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#092232]/70 border border-sky-500/30 text-xs font-medium text-sky-300 hover:text-white hover:bg-sky-900/60 hover:border-sky-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke Telegram"
            >
              <TelegramIcon className="w-3.5 h-3.5 text-sky-400 fill-sky-400" />
              <span>Telegram</span>
            </a>

            {/* Discord (Copies link with helpful feedback) */}
            <button
              type="button"
              id="discord-share-btn"
              class="px-3 py-1.5 rounded-xl bg-[#171334]/70 border border-indigo-500/30 text-xs font-medium text-indigo-300 hover:text-white hover:bg-indigo-900/60 hover:border-indigo-400 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
              title="Salin untuk dibagikan di Discord"
            >
              <DiscordIcon className="w-3.5 h-3.5 text-indigo-400 fill-indigo-400" />
              <span id="discord-share-text">Discord</span>
            </button>

            {/* LinkedIn */}
            <a
              href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(shareUrl)}`}
              data-share="linkedin"
              target="_blank"
              rel="noopener noreferrer"
              class="px-3 py-1.5 rounded-xl bg-[#0a1f33]/70 border border-cyan-500/30 text-xs font-medium text-cyan-300 hover:text-white hover:bg-cyan-900/60 hover:border-cyan-400 transition-all flex items-center gap-1.5 shadow-sm active:scale-95"
              title="Bagikan ke LinkedIn"
            >
              <LinkedinIcon className="w-3.5 h-3.5 text-cyan-400 fill-cyan-400" />
              <span>LinkedIn</span>
            </a>
          </div>
        </div>

        {/* Author Bio Box */}
        <div class="mt-10 p-6 rounded-3xl bg-[#0D0818]/90 border border-purple-500/25 flex items-center gap-5">
          <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-purple-600 to-fuchsia-600 flex items-center justify-center text-white font-extrabold text-xl shrink-0 shadow-lg">
            G
          </div>
          <div>
            <h4 class="text-sm font-bold text-white">Ditulis oleh Gentha Arya Pratama</h4>
            <p class="text-xs text-zinc-400 mt-1 leading-relaxed">
              Fullstack Developer berdedikasi membangun aplikasi web &amp; mobile modern dengan fokus pada performa, arsitektur bersih, dan user experience.
            </p>
          </div>
        </div>

        {/* Feedback & Social Reactions Section (Disimpan di Bagian Bawah) */}
        <div class="mt-6">
          <ArticleInteractiveBar client:load slug={post.slug} title={post.title} articleSelector=".article-prose" mode="bottom" />
        </div>
      </div>

      {/* Sidebar: Table of Contents & Related */}
      <div class="lg:col-span-4 sticky top-28 space-y-6">
        {headings.length > 0 && (
          <div class="p-6 rounded-3xl bg-[#0D0818]/90 border border-purple-500/20 shadow-xl">
            <h3 class="text-xs font-bold text-zinc-300 uppercase tracking-wider mb-4 flex items-center gap-2">
              <BookOpen className="w-4 h-4 text-purple-400" />
              <span>Daftar Isi</span>
            </h3>
            <ul class="space-y-2.5 text-xs">
              {headings.map((h) => (
                <li>
                  <a
                    href={`#${h.id}`}
                    class="text-zinc-400 hover:text-purple-300 transition-colors line-clamp-1 block py-0.5"
                  >
                    • {h.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Related Posts */}
        {relatedPosts.length > 0 && (
          <div class="p-5 sm:p-6 rounded-3xl bg-[#0D0818]/90 border border-purple-500/20 shadow-xl">
            <h3 class="text-xs font-bold text-zinc-300 uppercase tracking-wider mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.8)]" />
              <span>Artikel Terkait</span>
            </h3>
            <div class="space-y-3.5">
              {relatedPosts.map((r) => (
                <a
                  key={r.id}
                  href={`/article/${r.slug}`}
                  class="group flex items-center gap-3.5 p-2.5 rounded-2xl bg-[#120B24]/60 border border-purple-500/15 hover:border-purple-400/40 hover:bg-[#160D2C] transition-all"
                >
                  <div class="w-16 h-12 rounded-xl overflow-hidden bg-[#0a0515] border border-purple-500/20 shrink-0 flex items-center justify-center">
                    <img
                      src={r.coverImageUrl}
                      alt={r.title}
                      loading="lazy"
                      class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                    />
                  </div>
                  <div class="flex-1 min-w-0">
                    <h4 class="text-xs font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2 leading-snug mb-1">
                      {r.title}
                    </h4>
                    <div class="flex items-center gap-2 text-[10px] text-zinc-400">
                      <span>{formatDate(r.publishedAt || r.createdAt)}</span>
                      <span>•</span>
                      <span class="text-purple-300">{r.readingTimeMinutes || 3} min</span>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        {/* Banner Iklan: Jasa Pembuatan Aplikasi (Fastwork CTA) */}
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#1E0D3D] via-[#14082B] to-[#0A0418] border-2 border-purple-500/40 p-6 shadow-[0_16px_40px_rgba(168,85,247,0.25)] group">
          {/* Ambient Glow */}
          <div class="absolute -top-12 -right-12 w-36 h-36 bg-fuchsia-500/20 rounded-full blur-2xl pointer-events-none" />
          <div class="absolute -bottom-12 -left-12 w-36 h-36 bg-purple-600/20 rounded-full blur-2xl pointer-events-none" />

          <div class="relative z-10">
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-gradient-to-r from-purple-500/25 to-fuchsia-500/25 border border-purple-400/35 text-purple-200 text-[10px] font-bold uppercase tracking-wider mb-3.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 shadow-[0_0_8px_rgba(52,211,153,0.8)] animate-pulse" />
              <span>Tersedia untuk Project</span>
            </div>

            <h3 class="text-lg font-extrabold text-white leading-snug mb-2 group-hover:text-purple-200 transition-colors">
              Ingin Membuat Aplikasi Web atau Mobile?
            </h3>

            <p class="text-xs text-zinc-300 leading-relaxed mb-5">
              Konsultasikan kebutuhan pembuatan aplikasi Anda—mulai dari sistem enterprise, landing page berkonversi tinggi, hingga aplikasi Android. Pengerjaan cepat, aman, dan bergaransi via <strong class="text-purple-300">Fastwork</strong>.
            </p>

            <div class="space-y-2 mb-6">
              <div class="flex items-center gap-2 text-[11px] text-zinc-300">
                <Laptop class="w-3.5 h-3.5 text-purple-400 shrink-0" />
                <span>Web Application &amp; Custom Dashboard</span>
              </div>
              <div class="flex items-center gap-2 text-[11px] text-zinc-300">
                <Smartphone class="w-3.5 h-3.5 text-fuchsia-400 shrink-0" />
                <span>Mobile App Android (React Native)</span>
              </div>
            </div>

            <a
              href="https://fastwork.id/user/babfpfzm"
              target="_blank"
              class="w-full py-3 px-4 rounded-xl text-xs font-bold text-center text-white bg-gradient-to-r from-purple-600 via-fuchsia-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 shadow-lg shadow-purple-600/40 hover:shadow-purple-500/60 hover:scale-[1.02] active:scale-95 transition-all flex items-center justify-center gap-2 block select-none cursor-pointer"
            >
              <FastworkIcon className="w-4 h-4 text-amber-300" />
              <span>Konsultasi Sekarang</span>
              <ArrowUpRight class="w-3.5 h-3.5" />
            </a>

            <div class="mt-3 text-center">
              <span class="text-[10px] text-zinc-400 font-mono">
                100% Aman &amp; Rekber Resmi Fastwork
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>

    {/* Section: Artikel Lainnya (More Articles Recommendation Grid) */}
    {moreArticles.length > 0 && (
      <div class="mt-20 pt-12 border-t border-purple-500/20">
        <div class="flex items-center justify-between mb-8">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-600/15 border border-purple-500/25 text-purple-300 text-xs font-semibold uppercase tracking-wider mb-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.8)]" />
              <span>Rekomendasi Bacaan</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              Artikel Lainnya
            </h3>
          </div>

          <a
            href="/article"
            class="inline-flex items-center gap-1.5 text-xs font-bold text-purple-400 hover:text-purple-300 transition-colors"
          >
            <span>Lihat Semua</span>
            <ArrowRight className="w-4 h-4" />
          </a>
        </div>

        <div class="flex flex-col gap-4">
          {moreArticles.map((art) => (
            <a
              key={art.id}
              href={`/article/${art.slug}`}
              class="group rounded-3xl bg-gradient-to-r from-[#0F0820]/90 via-[#130A26]/85 to-[#0A0515]/90 border border-purple-500/20 hover:border-purple-400/50 p-4 sm:p-5 flex flex-col sm:flex-row items-stretch sm:items-center gap-4 sm:gap-6 transition-all duration-300 hover:shadow-[0_12px_35px_rgba(139,92,246,0.2)] hover:-translate-y-1"
            >
              {/* Thumbnail Container: Aspect 16/9 with contain */}
              <div class="relative w-full sm:w-56 md:w-64 sm:min-w-[224px] md:min-w-[256px] aspect-[16/9] rounded-2xl overflow-hidden bg-[#0a0515] border border-purple-500/20 shrink-0 flex items-center justify-center">
                <img
                  src={art.coverImageUrl}
                  alt={art.title}
                  loading="lazy"
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                />
              </div>

              {/* Content Details */}
              <div class="flex-1 flex flex-col justify-between min-w-0">
                <div>
                  <div class="flex flex-wrap items-center gap-2.5 text-[11px] text-zinc-400 mb-2">
                    <span class="flex items-center gap-1 text-purple-300 font-medium">
                      <Clock className="w-3.5 h-3.5 text-purple-400" />
                      <span>{art.readingTimeMinutes || 4} min baca</span>
                    </span>
                    <span>•</span>
                    <span>{formatDate(art.publishedAt || art.createdAt)}</span>
                  </div>

                  <h4 class="text-base sm:text-lg font-bold text-white group-hover:text-purple-300 transition-colors line-clamp-2 leading-snug mb-2">
                    {art.title}
                  </h4>

                  <p class="text-xs sm:text-sm text-zinc-400 leading-relaxed line-clamp-2">
                    {art.excerpt}
                  </p>
                </div>

                <div class="mt-3.5 pt-2.5 border-t border-purple-500/15 flex items-center justify-between text-xs font-semibold text-purple-400 group-hover:text-purple-300">
                  <span>Baca Selengkapnya</span>
                  <ArrowUpRight className="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

  </article>

  {/* Full Image Modal Lightbox */}
  <div
    id="image-modal-lightbox"
    class="fixed inset-0 z-[9999] bg-black/95 backdrop-blur-lg flex items-center justify-center p-4 sm:p-8"
    style="display: none; opacity: 0; transition: opacity 0.25s ease;"
    role="dialog"
    aria-modal="true"
    aria-label="Tampilan Gambar Penuh"
  >
    {/* Close Button Top Right */}
    <button
      id="modal-close-btn"
      type="button"
      class="absolute top-5 right-5 z-30 w-11 h-11 rounded-full bg-[#180E2B]/90 hover:bg-[#2A1647] border border-purple-500/40 text-white flex items-center justify-center transition-all shadow-2xl hover:scale-105 active:scale-95 cursor-pointer"
      title="Tutup (Esc)"
    >
      <svg class="w-5 h-5 text-purple-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    {/* Controls Top Bar: Original Source link */}
    <div class="absolute top-5 left-5 z-30 flex items-center gap-3">
      <a
        id="modal-open-original"
        href="#"
        target="_blank"
        rel="noopener noreferrer"
        class="px-3.5 py-1.5 rounded-full bg-[#180E2B]/90 hover:bg-[#2A1647] border border-purple-500/40 text-xs text-purple-200 hover:text-white flex items-center gap-1.5 backdrop-blur-md transition-all shadow-lg"
      >
        <span>Buka Asli</span>
        <svg class="w-3.5 h-3.5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
          <polyline points="15 3 21 3 21 9"></polyline>
          <line x1="10" y1="14" x2="21" y2="3"></line>
        </svg>
      </a>
    </div>

    {/* Modal Image Wrapper */}
    <div class="relative max-w-6xl max-h-[85vh] w-full flex flex-col items-center justify-center select-none" id="modal-content-container">
      <img
        id="modal-lightbox-img"
        src=""
        alt=""
        class="max-w-full max-h-[80vh] w-auto h-auto object-contain rounded-2xl shadow-[0_20px_60px_rgba(168,85,247,0.35)] border border-purple-500/40"
      />
      <p
        id="modal-image-caption"
        class="mt-3.5 text-xs sm:text-sm text-zinc-300 text-center font-medium max-w-2xl px-4 line-clamp-2"
      ></p>
    </div>
  </div>

  {/* Client script for auto-incrementing view count, copy button, and code block copy buttons */}
  <script define:vars={{ slug }}>
    // Increment view count in background (with deduplication session via cookie & localStorage)
    const viewStorageKey = `viewed_post_${slug}`;
    const lastViewedAt = localStorage.getItem(viewStorageKey);
    const now = Date.now();
    const shouldSendView = !lastViewedAt || (now - parseInt(lastViewedAt, 10) > 24 * 60 * 60 * 1000);

    fetch(`/api/article/${slug}/view`, { method: 'POST' })
      .then((res) => res.json())
      .then((data) => {
        if (data && typeof data.viewsCount === 'number') {
          const displayEl = document.getElementById('view-count-display');
          if (displayEl) {
            displayEl.textContent = `${data.viewsCount} views`;
          }
          if (data.incremented) {
            localStorage.setItem(viewStorageKey, String(now));
          }
        }
      })
      .catch(() => {});

    // Automatically update share URLs to active browser URL (avoiding localhost or stale host)
    const currentUrl = window.location.href;
    const postTitle = document.title || 'Artikel';

    const waLink = document.querySelector('a[data-share="whatsapp"]');
    if (waLink) waLink.href = `https://wa.me/?text=${encodeURIComponent(postTitle + ' — ' + currentUrl)}`;

    const fbLink = document.querySelector('a[data-share="facebook"]');
    if (fbLink) fbLink.href = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`;

    const tgLink = document.querySelector('a[data-share="telegram"]');
    if (tgLink) tgLink.href = `https://t.me/share/url?url=${encodeURIComponent(currentUrl)}&text=${encodeURIComponent(postTitle)}`;

    const inLink = document.querySelector('a[data-share="linkedin"]');
    if (inLink) inLink.href = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(currentUrl)}`;

    // Copy link helper
    const copyBtn = document.getElementById('copy-link-btn');
    const copyText = document.getElementById('copy-text');
    if (copyBtn && copyText) {
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        copyText.textContent = 'Tersalin!';
        setTimeout(() => {
          copyText.textContent = 'Salin Link';
        }, 2000);
      });
    }

    // Discord share helper (copies link and informs user to paste into Discord)
    const discordBtn = document.getElementById('discord-share-btn');
    const discordText = document.getElementById('discord-share-text');
    if (discordBtn && discordText) {
      discordBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        discordText.textContent = 'Link Tersalin!';
        setTimeout(() => {
          discordText.textContent = 'Discord';
        }, 2000);
      });
    }

    // Auto-inject copy buttons to all <pre> code blocks inside article
    document.querySelectorAll('.article-prose pre').forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return;
      pre.style.position = 'relative';

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy-btn absolute top-2.5 right-2.5 px-2.5 py-1 rounded-lg text-[10px] font-semibold bg-[#1a0f30]/90 text-purple-300 border border-purple-500/30 hover:bg-purple-900/60 hover:text-white transition-all cursor-pointer backdrop-blur-sm shadow';
      btn.textContent = 'Salin Kode';

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const codeText = pre.querySelector('code')?.innerText || pre.innerText || '';
        navigator.clipboard.writeText(codeText);
        btn.textContent = '✓ Tersalin!';
        btn.classList.add('text-emerald-400', 'border-emerald-500/50');
        setTimeout(() => {
          btn.textContent = 'Salin Kode';
          btn.classList.remove('text-emerald-400', 'border-emerald-500/50');
        }, 2000);
      });

      pre.appendChild(btn);
    });

    // Copy Protection Watermark: Otomatis sisipkan atribusi & link artikel saat teks di-copy
    const articleContainer = document.querySelector('.article-prose');
    if (articleContainer) {
      articleContainer.addEventListener('copy', (e) => {
        const selection = window.getSelection();
        if (!selection || selection.rangeCount === 0) return;

        const selectedText = selection.toString();
        // Hanya tambahkan watermark jika teks yang disalin memiliki panjang lebih dari 30 karakter
        if (selectedText.length > 30) {
          e.preventDefault();
          const pageTitle = document.title || 'Artikel Gentha Arya Pratama';
          const pageUrl = window.location.href;
          const watermark = `\n\n----------------------------------------\nSumber: ${pageTitle}\nBaca artikel selengkapnya di: ${pageUrl}\nHak Cipta © Gentha Arya Pratama (https://mgentaarya.my.id)`;
          const copyContent = selectedText + watermark;

          if (e.clipboardData) {
            e.clipboardData.setData('text/plain', copyContent);
          } else if ((window as any).clipboardData) {
            (window as any).clipboardData.setData('Text', copyContent);
          }
        }
      });
    }

    // Modal Full Image Lightbox Logic (Hero Cover & Article Content Images)
    const lightboxModal = document.getElementById('image-modal-lightbox');
    const lightboxImg = document.getElementById('modal-lightbox-img');
    const lightboxCaption = document.getElementById('modal-image-caption');
    const lightboxCloseBtn = document.getElementById('modal-close-btn');
    const lightboxOrigLink = document.getElementById('modal-open-original');

    function openLightbox(src, altText) {
      if (!lightboxModal || !lightboxImg) return;
      lightboxImg.src = src;
      lightboxImg.alt = altText || 'Preview Gambar';
      if (lightboxCaption) {
        lightboxCaption.textContent = altText || '';
      }
      if (lightboxOrigLink) {
        lightboxOrigLink.href = src;
      }

      lightboxModal.style.display = 'flex';
      // Force repaint
      void lightboxModal.offsetWidth;
      lightboxModal.style.opacity = '1';
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightboxModal) return;
      lightboxModal.style.opacity = '0';
      setTimeout(() => {
        lightboxModal.style.display = 'none';
        if (lightboxImg) lightboxImg.src = '';
        document.body.style.overflow = '';
      }, 250);
    }

    // Attach click listener to Hero Cover Container
    const heroCoverContainer = document.getElementById('hero-cover-container');
    const heroCoverImg = document.getElementById('hero-cover-img');
    if (heroCoverContainer && heroCoverImg) {
      heroCoverContainer.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openLightbox(heroCoverImg.src, heroCoverImg.alt);
      });
      heroCoverContainer.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox(heroCoverImg.src, heroCoverImg.alt);
        }
      });
    }

    // Attach click listener to all images inside article content (.article-prose)
    document.querySelectorAll('.article-prose img').forEach((img) => {
      img.classList.add('cursor-zoom-in', 'hover:opacity-90', 'transition-opacity');
      img.setAttribute('title', 'Klik untuk melihat gambar penuh');
      img.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        openLightbox(img.src, img.alt);
      });
    });

    // Close button click
    if (lightboxCloseBtn) {
      lightboxCloseBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        closeLightbox();
      });
    }

    // Backdrop click to close (click outside the image wrapper)
    if (lightboxModal) {
      lightboxModal.addEventListener('click', (e) => {
        const contentContainer = document.getElementById('modal-content-container');
        if (contentContainer && !contentContainer.contains(e.target) && e.target !== lightboxOrigLink && !lightboxOrigLink?.contains(e.target)) {
          closeLightbox();
        }
      });
    }

    // Keyboard ESC key to close
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && lightboxModal && lightboxModal.style.display !== 'none') {
        closeLightbox();
      }
    });
  </script>
</PublicLayout>

