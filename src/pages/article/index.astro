---
import PublicLayout from '../../layouts/PublicLayout.astro';
import BlogSearchList from '../../components/public/BlogSearchList';
import BlogHeadlineCarousel from '../../components/public/BlogHeadlineCarousel';
import { db } from '../../db';
import { blogPosts, blogCategories } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { Clock, ArrowUpRight } from 'lucide-react';
import { formatDate } from '../../lib/utils';

let allPosts: any[] = [];
let categories: any[] = [];
let featuredPost: any = null;

try {
  const [categoriesRes, postsRaw] = await Promise.all([
    db.select().from(blogCategories).catch(() => []),
    db
      .select({
        id: blogPosts.id,
        title: blogPosts.title,
        slug: blogPosts.slug,
        excerpt: blogPosts.excerpt,
        coverImageUrl: blogPosts.coverImageUrl,
        readingTimeMinutes: blogPosts.readingTimeMinutes,
        viewsCount: blogPosts.viewsCount,
        publishedAt: blogPosts.publishedAt,
        createdAt: blogPosts.createdAt,
        isFeatured: blogPosts.isFeatured,
        categoryId: blogPosts.categoryId,
      })
      .from(blogPosts)
      .where(eq(blogPosts.status, 'published'))
      .orderBy(desc(blogPosts.createdAt))
      .catch(() => []),
  ]);

  categories = categoriesRes || [];
  const catMap = new Map(categories.map((c: any) => [c.id, c.name]));

  allPosts = (postsRaw || []).map((p: any) => ({
    ...p,
    categoryName: p.categoryId ? catMap.get(p.categoryId) : undefined,
  }));

  featuredPost = allPosts.find((p) => p.isFeatured) || allPosts[0];
} catch (err) {
  console.error('Error fetching blog catalog:', err);
}
---

<PublicLayout
  title="Article & Rekayasa Teknologi — Gentha Arya Pratama"
  description="Kumpulan artikel, panduan teknis, dan studi kasus arsitektur web modern, database MySQL, dan rekayasa mobile oleh Gentha Arya Pratama."
  ogImage={featuredPost?.coverImageUrl || '/og-image.png'}
>
  <div class="pt-32 pb-24 max-w-6xl mx-auto px-4 sm:px-6">
    
    {/* Page Header */}
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-600/10 border border-purple-500/25 text-purple-300 text-xs font-semibold uppercase tracking-wider mb-3">
        Knowledge Base &amp; Insights
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Catatan Teknis, Arsitektur &amp; <span class="text-gradient-aurora">Eksplorasi Kode</span>
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 mt-3">
        Dokumentasi pengalaman nyata dalam merancang sistem web performan, optimasi database, dan pembuatan aplikasi mobile.
      </p>
    </div>

    {/* Top 5 Headline Carousel */}
    {allPosts.length > 0 && (
      <BlogHeadlineCarousel client:load posts={allPosts} />
    )}

    {/* Search & Filterable Blog List */}
    <BlogSearchList client:load initialPosts={allPosts} categories={categories} />

    {/* Index Direktori Artikel (Single Unified Master Card) */}
    {allPosts.length > 0 && (
      <section class="mt-20 pt-14 border-t border-purple-500/20" id="article-index">
        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-[#120826]/90 via-[#0D051C]/95 to-[#080312] border-2 border-purple-500/25 p-6 sm:p-8 md:p-10 shadow-[0_20px_50px_rgba(168,85,247,0.15)] group">
          {/* Ambient Glows */}
          <div class="absolute -top-16 -right-16 w-56 h-56 bg-purple-600/15 rounded-full blur-3xl pointer-events-none" />
          <div class="absolute -bottom-16 -left-16 w-56 h-56 bg-fuchsia-600/15 rounded-full blur-3xl pointer-events-none" />

          <div class="relative z-10">
            {/* Header in Master Card */}
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-4 pb-6 mb-8 border-b border-purple-500/20">
              <div>
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-500/15 border border-purple-400/30 text-purple-200 text-[10px] font-bold uppercase tracking-wider mb-2.5">
                  <span class="w-1.5 h-1.5 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.8)]" />
                  <span>Direktori Lengkap Artikel</span>
                </div>
                <h2 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">
                  Indeks Arsip &amp; Topik Rekayasa
                </h2>
                <p class="text-xs sm:text-sm text-zinc-400 mt-1">
                  Daftar komprehensif seluruh materi teknis yang dikelompokkan berdasarkan kategori.
                </p>
              </div>

              <div class="flex items-center gap-3 shrink-0">
                <span class="text-xs font-mono text-zinc-300 px-3.5 py-1.5 rounded-xl bg-[#160B2C] border border-purple-500/30">
                  Total <strong class="text-purple-300">{allPosts.length}</strong> Artikel
                </span>
                <button
                  type="button"
                  onclick="window.scrollTo({ top: 320, behavior: 'smooth' })"
                  class="px-3.5 py-1.5 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-purple-600 to-fuchsia-600 hover:from-purple-500 hover:to-fuchsia-500 shadow-md shadow-purple-600/30 transition-all flex items-center gap-1.5 cursor-pointer active:scale-95"
                  title="Cari artikel di bagian atas"
                >
                  <span>Pencarian</span>
                  <ArrowUpRight className="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            {/* Category Sub-sections in Single Card */}
            <div class="space-y-8">
              {categories.map((cat: any) => {
                const catPosts = allPosts.filter((p) => p.categoryId === cat.id);
                if (catPosts.length === 0) return null;

                return (
                  <div key={cat.id} class="rounded-2xl bg-[#140B28]/50 border border-purple-500/15 p-4 sm:p-5">
                    {/* Category Title Row */}
                    <div class="flex items-center justify-between pb-3 mb-3 border-b border-purple-500/15">
                      <div class="flex items-center gap-2">
                        <span class="w-2 h-2 rounded-full bg-purple-400" />
                        <h3 class="text-xs sm:text-sm font-bold text-white tracking-wide">
                          {cat.name}
                        </h3>
                      </div>
                      <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-purple-900/50 text-purple-300 border border-purple-500/25">
                        {catPosts.length} artikel
                      </span>
                    </div>

                    {/* Compact 2-column or 3-column List */}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-2.5">
                      {catPosts.map((post) => (
                        <a
                          key={post.id}
                          href={`/article/${post.slug}`}
                          class="group/item flex items-center justify-between gap-2 py-1 text-xs text-zinc-300 hover:text-purple-300 transition-colors"
                        >
                          <span class="line-clamp-1 group-hover/item:translate-x-0.5 transition-transform">
                            • {post.title}
                          </span>
                          <span class="text-[10px] font-mono text-zinc-400 shrink-0">
                            {formatDate(post.publishedAt || post.createdAt)}
                          </span>
                        </a>
                      ))}
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </section>
    )}

  </div>
</PublicLayout>

