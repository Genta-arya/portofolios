---
import PublicLayout from '../../layouts/PublicLayout.astro';
import BlogSearchList from '../../components/public/BlogSearchList';
import BlogHeadlineCarousel from '../../components/public/BlogHeadlineCarousel';
import { db } from '../../db';
import { blogPosts, blogCategories } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';
import { Clock, ArrowUpRight } from 'lucide-react';
import { formatDate } from '../../lib/utils';

let allPosts: any[] = [];
let categories: any[] = [];
let featuredPost: any = null;

try {
  const [categoriesRes, postsRaw] = await Promise.all([
    db.select().from(blogCategories).catch(() => []),
    db
      .select({
        id: blogPosts.id,
        title: blogPosts.title,
        slug: blogPosts.slug,
        excerpt: blogPosts.excerpt,
        coverImageUrl: blogPosts.coverImageUrl,
        readingTimeMinutes: blogPosts.readingTimeMinutes,
        viewsCount: blogPosts.viewsCount,
        publishedAt: blogPosts.publishedAt,
        createdAt: blogPosts.createdAt,
        isFeatured: blogPosts.isFeatured,
        categoryId: blogPosts.categoryId,
      })
      .from(blogPosts)
      .where(eq(blogPosts.status, 'published'))
      .orderBy(desc(blogPosts.createdAt))
      .catch(() => []),
  ]);

  categories = categoriesRes || [];
  const catMap = new Map(categories.map((c: any) => [c.id, c.name]));

  allPosts = (postsRaw || []).map((p: any) => ({
    ...p,
    categoryName: p.categoryId ? catMap.get(p.categoryId) : undefined,
  }));

  featuredPost = allPosts.find((p) => p.isFeatured) || allPosts[0];
} catch (err) {
  console.error('Error fetching blog catalog:', err);
}
---

<PublicLayout
  title="Article & Rekayasa Teknologi — Gentha Arya Pratama"
  description="Kumpulan artikel, panduan teknis, dan studi kasus arsitektur web modern, database MySQL, dan rekayasa mobile oleh Gentha Arya Pratama."
  ogImage={featuredPost?.coverImageUrl || '/og-image.png'}
>
  <div class="pt-32 pb-24 max-w-6xl mx-auto px-4 sm:px-6">
    
    {/* Page Header */}
    <div class="max-w-3xl mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-600/10 border border-purple-500/25 text-purple-300 text-xs font-semibold uppercase tracking-wider mb-3">
        Knowledge Base &amp; Insights
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Catatan Teknis, Arsitektur &amp; <span class="text-gradient-aurora">Eksplorasi Kode</span>
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 mt-3">
        Dokumentasi pengalaman nyata dalam merancang sistem web performan, optimasi database, dan pembuatan aplikasi mobile.
      </p>
    </div>

    {/* Top 5 Headline Carousel */}
    {allPosts.length > 0 && (
      <BlogHeadlineCarousel client:load posts={allPosts} />
    )}

    {/* Search & Filterable Blog List */}
    <BlogSearchList client:load initialPosts={allPosts} categories={categories} />

    {/* Index Direktori Artikel (Sitemap & Arsip Lengkap Seluruh Topik & Kategori) */}
    {allPosts.length > 0 && (
      <section class="mt-24 pt-16 border-t border-purple-500/20" id="article-index">
        <div class="flex flex-col md:flex-row items-start md:items-end justify-between gap-4 mb-10">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-purple-600/15 border border-purple-500/30 text-purple-300 text-[11px] font-bold uppercase tracking-wider mb-2.5">
              <span>Direktori &amp; Arsip Lengkap</span>
            </div>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
              Indeks Seluruh Artikel &amp; Topik Teknologi
            </h2>
            <p class="text-xs sm:text-sm text-zinc-400 mt-1.5 max-w-xl">
              Jelajahi seluruh koleksi {allPosts.length} artikel rekayasa perangkat lunak yang dikelompokkan secara terstruktur berdasarkan spesialisasi teknologi.
            </p>
          </div>
          <div class="text-xs font-mono text-zinc-400 px-3.5 py-1.5 rounded-xl bg-[#0D0818] border border-purple-500/25 shrink-0">
            Total Arsip: <strong class="text-purple-300">{allPosts.length}</strong> Publikasi
          </div>
        </div>

        {/* Index Grid Grouped by Categories */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {categories.map((cat: any) => {
            const catPosts = allPosts.filter((p) => p.categoryId === cat.id);
            if (catPosts.length === 0) return null;

            return (
              <div
                key={cat.id}
                class="rounded-3xl bg-[#0C061A]/80 border border-purple-500/20 p-5 sm:p-6 shadow-xl hover:border-purple-500/40 transition-all flex flex-col justify-between"
              >
                <div>
                  <div class="flex items-center justify-between pb-3.5 mb-3.5 border-b border-purple-500/15">
                    <h3 class="text-sm font-bold text-white flex items-center gap-2">
                      <span class="w-2 h-2 rounded-full bg-purple-400 shadow-[0_0_8px_rgba(192,132,252,0.8)]" />
                      <span>{cat.name}</span>
                    </h3>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-purple-900/40 text-purple-300 border border-purple-500/30">
                      {catPosts.length} pos
                    </span>
                  </div>

                  <ul class="space-y-2.5">
                    {catPosts.slice(0, 7).map((post) => (
                      <li key={post.id}>
                        <a
                          href={`/article/${post.slug}`}
                          class="group/item flex items-start justify-between gap-2 text-xs text-zinc-300 hover:text-purple-300 transition-colors py-0.5"
                        >
                          <span class="line-clamp-1 group-hover/item:translate-x-0.5 transition-transform">
                            {post.title}
                          </span>
                          <span class="text-[10px] font-mono text-zinc-400 shrink-0">
                            {formatDate(post.publishedAt || post.createdAt)}
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                {catPosts.length > 7 && (
                  <div class="mt-4 pt-3 border-t border-purple-500/15 text-[11px] text-zinc-400 font-medium">
                    +{catPosts.length - 7} artikel lainnya dalam topik ini
                  </div>
                )}
              </div>
            );
          })}
        </div>

        {/* Global Quick A-Z Alphabetic Directory Pills */}
        <div class="mt-12 p-6 rounded-3xl bg-gradient-to-r from-[#0E0722] via-[#090416] to-[#0E0722] border border-purple-500/25 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="text-center sm:text-left">
            <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-1">
              Pencarian Cepat Berdasarkan Judul
            </h4>
            <p class="text-[11px] text-zinc-400">
              Gunakan pencarian cerdas di atas untuk memfilter artikel secara instan menurut kata kunci dan tag.
            </p>
          </div>
          <button
            type="button"
            onclick="window.scrollTo({ top: 320, behavior: 'smooth' })"
            class="px-4 py-2 rounded-xl text-xs font-bold text-white bg-[#150B2E] border border-purple-500/30 hover:border-purple-400 hover:bg-purple-900/40 transition-all flex items-center gap-1.5 cursor-pointer shadow-sm active:scale-95"
          >
            <span>Kembali ke Pencarian</span>
            <ArrowUpRight className="w-3.5 h-3.5 text-purple-400" />
          </button>
        </div>
      </section>
    )}

  </div>
</PublicLayout>

